{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axx",
  "version": "0.22.4",
  "identifier": "com.axx.desktop",
  "build": {
    "frontendDist": "../1.AXX"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Axx",
        "url": "Axx.html",
        "width": 400,
        "height": 400,
        "minWidth": 96,
        "minHeight": 96,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "maximized": false,
        "maximizable": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/axx-backend.exe",
      "resources/ai-memory.exe",
      "resources/ai-memory-LICENSE",
      "resources/license-notices/"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
