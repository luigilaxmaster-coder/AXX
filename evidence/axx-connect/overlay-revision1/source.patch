+            args = [str(executable), 'app-server', '--listen', 'stdio://',
+                    '-c', 'model_provider="openai"', '-c', 'forced_login_method="chatgpt"',
+                    '-c', 'web_search="disabled"', '-c', 'mcp_servers={}', '-c', 'plugins={}',
+                    '-c', 'features.shell_tool=false', '-c', 'features.unified_exec=false',
