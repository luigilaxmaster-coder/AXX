+                        # execution gate: no effect was dispatched by this
+                        # attempt. Only this admission failure can be retried.
+                        with self.lock:
+                            if self.closed:
+                                return
+                            pending = self.get_task(operation_id)
+                            if not pending or pending['state'] in TERMINAL:
+                                return
