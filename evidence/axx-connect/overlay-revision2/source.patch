+        if not row:
+            raise ProviderError('NOT_FOUND', 'No existe esa ejecución de Axx Connect.')
+        return json.loads(row['body_json'])
+
+    def _spawn(self):
+        with self._budget_lock(self.start_lock):
+            if self.closed:
