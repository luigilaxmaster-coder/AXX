+                                                     'message': _safe_error(exc)}}
+                success = False
+                if isinstance(exc, ProviderError) and exc.code in {'ACCOUNT_CHANGED', 'DISCONNECTED', 'DEADLINE_EXCEEDED'}:
+                    with self.lock:
