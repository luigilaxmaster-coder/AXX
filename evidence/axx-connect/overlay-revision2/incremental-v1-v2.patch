+class ControlledPipe:
+    def __init__(self, blocked=None):
+        self.blocked = blocked
+        self.entered, self.release = threading.Event(), threading.Event()
+        self.messages = []
+
+    def _wait(self, phase):
+        if self.blocked == phase:
+            self.entered.set()
+            if not self.release.wait(2):
+                raise OSError('Controlled blocked pipe was not released')
+
+    def write(self, payload):
+        self.messages.append(payload)
+        self._wait('write')
+        return len(payload)
+
+    def flush(self):
+        self._wait('flush')
+
+    def close(self):
+        self._wait('close')
+
+
+class ControlledProcess:
+    def __init__(self, stream):
+        self.stdin = stream
+        self.returncode = None
+        self.terminated, self.killed, self.waits = 0, 0, []
+        self.exited = threading.Event()
+
+    def poll(self):
+        return self.returncode
+
+    def terminate(self):
+        self.terminated += 1
+        self.returncode = -15
+        self.stdin.release.set()
+        self.exited.set()
+
+    def kill(self):
+        self.killed += 1
+        self.terminate()
+
+    def wait(self, timeout):
+        self.waits.append(timeout)
+        if not self.exited.wait(timeout):
+            raise subprocess.TimeoutExpired('controlled-child', timeout)
+        return self.returncode
 
 
